<Window x:Class="MediaOrganizer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Professional Media Organizer"
        Width="1240" Height="820" MinWidth="1020" MinHeight="660"
        Background="#F4F6FA" FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E3E7EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#AEB9CF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,20,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#667085"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= Folders ================= -->
        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.ColumnSpan="3" Text="Professional Photo, Video &amp; Screenshot Organizer"
                           FontSize="20" FontWeight="SemiBold" Foreground="#1B2A49" Margin="0,0,0,2"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Foreground="#667085" Margin="0,0,0,10"
                           Text="Copies your media into a clean folder structure. Your original files are never moved, changed, compressed or deleted."/>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Source folder" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Padding="6,5" IsEnabled="{Binding CanEdit}"
                                 Text="{Binding SourceFolder, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Padding="14,5"
                                Command="{Binding BrowseSourceCommand}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Destination folder" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Padding="6,5" IsEnabled="{Binding CanEdit}"
                                 Text="{Binding DestinationFolder, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="2" Content="Browse..." Margin="8,0,0,0" Padding="14,5"
                                Command="{Binding BrowseDestinationCommand}"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Options + actions ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Folder structure and options" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <WrapPanel IsEnabled="{Binding CanEdit}">
                    <CheckBox Content="Year folders" IsChecked="{Binding UseYear}"/>
                    <CheckBox Content="Month folders (YYYY-MM)" IsChecked="{Binding UseMonth}"/>
                    <CheckBox Content="Location folders (photos &amp; videos)" IsChecked="{Binding UseLocation}"/>
                    <CheckBox Content="Group into events" IsChecked="{Binding GroupEvents}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,6" ToolTip="A new event starts when two files are further apart in time than this.">
                        <TextBlock Text="Event gap (hours):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Width="50" Padding="4,2" Text="{Binding EventGapHours, UpdateSourceTrigger=LostFocus, StringFormat=0.##}"/>
                    </StackPanel>
                    <CheckBox Content="Copy non-media files to Unclassified" IsChecked="{Binding IncludeNonMedia}"/>
                    <CheckBox Content="Also write Excel report" IsChecked="{Binding ExportExcel}"/>
                </WrapPanel>

                <Border Background="#EEF4FF" BorderBrush="#C9DAFB" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,2,0,10"
                        IsEnabled="{Binding CanEdit}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding OnlineGeocoding}" Margin="0,0,0,2"
                                  Content="Fetch place names online (city / locality from GPS)" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#475467" FontSize="12">
                            <Run Text="When on, only rounded GPS coordinates (about 1 km precision) are sent to OpenStreetMap to get names like &quot;Lucknow&quot;. "/>
                            <Run Text="Your photos, videos and file names are never uploaded. Results are cached on this PC. "/>
                            <Run Text="When off or offline, folders are named from coordinates (for example GPS_26.8N_80.9E)."/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <WrapPanel>
                    <Button Content="1. Analyze &amp; Preview" Style="{StaticResource PrimaryButton}" Command="{Binding AnalyzeCommand}"/>
                    <Button Content="2. Start / Resume" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}"/>
                    <Button Content="{Binding PauseText}" Style="{StaticResource SecondaryButton}" Command="{Binding PauseCommand}"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                    <Button Content="Retry failed" Style="{StaticResource SecondaryButton}" Command="{Binding RetryCommand}"/>
                    <Button Content="Open organized folder" Style="{StaticResource SecondaryButton}" Command="{Binding OpenOutputCommand}"/>
                    <Button Content="Open reports" Style="{StaticResource SecondaryButton}" Command="{Binding OpenReportsCommand}"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ================= Warning banner ================= -->
        <Border Grid.Row="2" Background="#FFF6E0" BorderBrush="#F2D48A" BorderThickness="1" CornerRadius="6"
                Padding="10,7" Margin="0,0,0,10">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" Foreground="#7A4B00"/>
        </Border>

        <!-- ================= Tabs ================= -->
        <TabControl Grid.Row="3" Background="White">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Cards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Card}" Width="172" Margin="0,0,10,10" Background="#F8FAFD">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="#667085" FontSize="12" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" Foreground="#1B2A49"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Media by year" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding YearBars}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Column="1" Height="12" Maximum="100" Margin="8,0" Value="{Binding Percent, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count, Mode=OneWay}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Top locations (photos &amp; videos)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding LocationBars}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="170"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="70"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Column="1" Height="12" Maximum="100" Margin="8,0" Value="{Binding Percent, Mode=OneWay}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Count, Mode=OneWay}" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Preview &amp; Files">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <WrapPanel Margin="0,0,0,8">
                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Search" Style="{StaticResource FilterLabel}"/>
                            <TextBox Width="190" Padding="4,3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Year" Style="{StaticResource FilterLabel}"/>
                            <ComboBox Width="80" ItemsSource="{Binding YearOptions}" SelectedItem="{Binding SelectedYear}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Month" Style="{StaticResource FilterLabel}"/>
                            <ComboBox Width="70" ItemsSource="{Binding MonthOptions}" SelectedItem="{Binding SelectedMonth}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Location" Style="{StaticResource FilterLabel}"/>
                            <ComboBox Width="150" ItemsSource="{Binding LocationOptions}" SelectedItem="{Binding SelectedLocation}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Category" Style="{StaticResource FilterLabel}"/>
                            <ComboBox Width="110" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Device / camera" Style="{StaticResource FilterLabel}"/>
                            <ComboBox Width="160" ItemsSource="{Binding DeviceOptions}" SelectedItem="{Binding SelectedDevice}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Format" Style="{StaticResource FilterLabel}"/>
                            <ComboBox Width="80" ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding SelectedFormat}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,6">
                            <TextBlock Text="Duplicates" Style="{StaticResource FilterLabel}"/>
                            <ComboBox Width="130" ItemsSource="{Binding DuplicateOptions}" SelectedItem="{Binding SelectedDuplicate}"/>
                        </StackPanel>
                    </WrapPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilesView}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              EnableRowVirtualization="True" SelectionMode="Extended">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="File" Binding="{Binding FileName, Mode=OneWay}" Width="190"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category, Mode=OneWay}" Width="85"/>
                            <DataGridTextColumn Header="Capture date" Binding="{Binding CaptureDateText, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="Date source" Binding="{Binding DateSourceText, Mode=OneWay}" Width="150"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="Device" Binding="{Binding Device, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="Resolution" Binding="{Binding Resolution, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText, Mode=OneWay}" Width="75"/>
                            <DataGridTextColumn Header="Duplicate" Binding="{Binding DuplicateText, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="People" Binding="{Binding PeopleText, Mode=OneWay}" Width="110"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Proposed destination" Binding="{Binding DestinationPath, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="#667085" Text="{Binding FilesCountText}"/>
                </Grid>
            </TabItem>

            <TabItem Header="People (optional)">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>

                        <!-- ===== on / off ===== -->
                        <Border Background="#EEF4FF" BorderBrush="#C9DAFB" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding FaceEnabled}" IsEnabled="{Binding CanEdit}" Margin="0,0,0,4"
                                          Content="Enable face recognition (optional)" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock TextWrapping="Wrap" Foreground="#475467" FontSize="12">
                                    <Run Text="Off by default. While it is off, no face model is loaded and nothing is scanned, so normal organizing is unchanged. "/>
                                    <Run Text="Everything runs on this PC: your photos and face data are never uploaded. Only face fingerprints (numbers, not pictures) are kept in %LocalAppData%\MediaOrganizer, and you can delete them at any time below."/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel IsEnabled="{Binding FaceEnabled}">

                            <!-- ===== 1. people ===== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="1. Registered people" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ListBox ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson}" MaxHeight="130" MinHeight="40">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Width="180"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="#667085"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <Button Content="Remove selected person" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                            Margin="0,6,0,10" Command="{Binding RemovePersonCommand}"/>

                                    <TextBlock Text="Add a person" Foreground="#667085" FontSize="11" Margin="0,0,0,2"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Padding="6,5" Text="{Binding NewPersonName, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="The person's name. It is also used as the folder name in People\"/>
                                        <Button Grid.Column="1" Content="Choose 1-4 reference photos..." Margin="8,0,0,0" Padding="12,5"
                                                Command="{Binding ChooseReferencesCommand}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding ReferenceSummary}" Margin="10,0" VerticalAlignment="Center"
                                                   Foreground="#667085" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReferenceSummary}"/>
                                        <Button Grid.Column="3" Content="Register person" Style="{StaticResource PrimaryButton}" Margin="0"
                                                Command="{Binding RegisterPersonCommand}"/>
                                    </Grid>
                                    <TextBlock Margin="0,6,0,0" Foreground="#667085" FontSize="12" TextWrapping="Wrap"
                                               Text="Use clear, well-lit, front-facing photos of only that person. More varied reference photos (different angle or lighting) give better matches."/>
                                </StackPanel>
                            </Border>

                            <!-- ===== 2. scan ===== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="2. Choose what to scan, then scan" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <RadioButton GroupName="faceScope" IsChecked="{Binding ScopeAll}" Content="Entire analyzed library" Margin="0,0,0,4"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <RadioButton GroupName="faceScope" IsChecked="{Binding ScopeFolder}" Content="A specific folder:" VerticalAlignment="Center"/>
                                        <TextBox Width="380" Padding="4,3" Margin="8,0,0,0" Text="{Binding FaceScopeFolder, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Content="Browse..." Margin="8,0,0,0" Padding="12,3" Command="{Binding BrowseFaceFolderCommand}"/>
                                    </StackPanel>
                                    <RadioButton GroupName="faceScope" IsChecked="{Binding ScopeSelected}" Margin="0,0,0,8"
                                                 Content="Only the files I select in the review list below"/>

                                    <WrapPanel Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,4"
                                                    ToolTip="How similar a face must be to count as the registered person (0.2 to 0.9). Higher = stricter, fewer wrong names but more missed matches.">
                                            <TextBlock Text="Match strictness:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="50" Padding="4,2" Text="{Binding FaceMatchThreshold, UpdateSourceTrigger=LostFocus, StringFormat=0.00}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,20,4"
                                                    ToolTip="Pictures taken from each video (spread across its length). More frames find more people but take longer.">
                                            <TextBlock Text="Frames per video:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="40" Padding="4,2" Text="{Binding FaceVideoFrames, UpdateSourceTrigger=LostFocus}"/>
                                        </StackPanel>
                                        <CheckBox Content="Create People\Name folders (extra verified copies)" IsChecked="{Binding CreatePersonFolders}"/>
                                        <CheckBox Content="Also collect unidentified people in People\_Unidentified_People" IsChecked="{Binding CollectUnidentified}"/>
                                    </WrapPanel>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Scan for faces" Style="{StaticResource PrimaryButton}" Command="{Binding ScanFacesCommand}"/>
                                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"/>
                                        <TextBlock VerticalAlignment="Center" Foreground="#667085" FontSize="12"
                                                   Text="Scanning only reads your files and copies nothing. Run Analyze &amp; Preview first."/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ===== 3. results ===== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="3. Results" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ItemsControl ItemsSource="{Binding FaceCards}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Card}" Width="172" Margin="0,0,10,10" Background="#F8FAFD">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" Foreground="#667085" FontSize="12" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding Value}" FontSize="22" FontWeight="SemiBold" Foreground="#1B2A49"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="Files per registered person" Foreground="#667085" FontSize="11" Margin="0,4,0,2"/>
                                    <ItemsControl ItemsSource="{Binding PersonBars}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="170"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label, Mode=OneWay}" TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Grid.Column="1" Height="12" Maximum="100" Margin="8,0" Value="{Binding Percent, Mode=OneWay}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Count, Mode=OneWay}" HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ===== 4. review ===== -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="4. Review and correct" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <WrapPanel Margin="0,0,0,6">
                                        <StackPanel Margin="0,0,10,4">
                                            <TextBlock Text="Show" Style="{StaticResource FilterLabel}"/>
                                            <ComboBox Width="190" ItemsSource="{Binding ReviewFilterOptions}" SelectedItem="{Binding SelectedReviewFilter}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,4">
                                            <TextBlock Text="Person" Style="{StaticResource FilterLabel}"/>
                                            <ComboBox Width="160" ItemsSource="{Binding ReviewPersonOptions}" SelectedItem="{Binding SelectedReviewPerson}"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,10,4">
                                            <TextBlock Text="File name" Style="{StaticResource FilterLabel}"/>
                                            <TextBox Width="170" Padding="4,3" Text="{Binding ReviewSearch, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                    </WrapPanel>

                                    <Grid Height="290">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <DataGrid x:Name="ReviewGrid" ItemsSource="{Binding ReviewView}" AutoGenerateColumns="False"
                                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                                                  EnableRowVirtualization="True" SelectionMode="Extended"
                                                  SelectionChanged="ReviewGrid_SelectionChanged">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="File" Binding="{Binding FileName, Mode=OneWay}" Width="190"/>
                                                <DataGridTextColumn Header="Type" Binding="{Binding Category, Mode=OneWay}" Width="80"/>
                                                <DataGridTextColumn Header="Result" Binding="{Binding FaceCategoryText, Mode=OneWay}" Width="150"/>
                                                <DataGridTextColumn Header="Faces" Binding="{Binding FaceCount, Mode=OneWay}" Width="50"/>
                                                <DataGridTextColumn Header="Recognized people" Binding="{Binding PeopleText, Mode=OneWay}" Width="*"/>
                                                <DataGridTextColumn Header="Unidentified" Binding="{Binding UnidentifiedFaces, Mode=OneWay}" Width="90"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <Border Grid.Column="2" BorderBrush="#E3E7EF" BorderThickness="1" CornerRadius="6" Padding="6">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <TextBlock Grid.Row="1" Text="{Binding PreviewCaption}" TextWrapping="Wrap" Foreground="#667085" FontSize="11" Margin="0,4,0,0"/>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="{Binding ReviewCountText}" Foreground="#667085" Margin="0,4,0,6"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Person:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Width="170" ItemsSource="{Binding PersonNames}" SelectedItem="{Binding CorrectionPerson}" Margin="0,0,10,0"/>
                                        <Button Content="Add to selected files" Style="{StaticResource SecondaryButton}" Command="{Binding AddPersonToSelectedCommand}"
                                                ToolTip="Use when the app missed this person in the selected file(s)."/>
                                        <Button Content="Remove from selected files" Style="{StaticResource SecondaryButton}" Command="{Binding RemovePersonFromSelectedCommand}"
                                                ToolTip="Use when the app named the wrong person in the selected file(s)."/>
                                    </StackPanel>
                                    <TextBlock Margin="0,4,0,0" Foreground="#667085" FontSize="12" TextWrapping="Wrap"
                                               Text="Corrections are remembered. After correcting, press Start / Resume to copy the changes into the People folder. Copies already made are kept - this app never deletes files."/>
                                </StackPanel>
                            </Border>

                            <Button Content="Delete all face data from this PC..." Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                                    Command="{Binding DeleteFaceDataCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Issues">
                <ListBox Margin="10" ItemsSource="{Binding Issues}" BorderThickness="0"/>
            </TabItem>
        </TabControl>

        <!-- ================= Progress ================= -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" Foreground="#667085" Margin="12,0,0,0"/>
                </Grid>
                <ProgressBar Height="10" Margin="0,8,0,0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             IsIndeterminate="{Binding IsIndeterminate}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
